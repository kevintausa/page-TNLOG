---
import { 
  Mail, 
  Phone, 
  MapPin, 
  Linkedin, 
  Facebook, 
  Instagram,
  ArrowUp,
  Globe,
  Truck,
  Award
} from 'lucide-astro';
---

<footer class="bg-gradient-to-br from-tn-blue-dark via-tn-blue to-tn-blue-dark text-white relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23FACB00" fill-opacity="0.3"%3E%3Ccircle cx="30" cy="30" r="1"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <!-- Main Footer Content -->
    <div class="py-16">
      <div class="grid lg:grid-cols-4 md:grid-cols-2 gap-8">
        <!-- Company Info -->
        <div class="lg:col-span-2 animate-on-scroll">
          <!-- Logo -->
          <div class="mb-6">
            <img 
              src="/logo-tn-logistics2.png" 
              alt="TN Logistics Consulting" 
              class="h-12 w-auto filter brightness-0 invert"
            />
          </div>
          
          <h4 class="text-xl font-intro-bold text-tn-yellow mb-4">
            Expandiendo Horizontes, Conectando Oportunidades
          </h4>
          
          <p class="text-gray-300 leading-relaxed mb-6 max-w-md">
            Somos tu aliado estratégico en logística internacional. Con más de 15 años de experiencia, 
            simplificamos lo complejo y te acompañamos en cada etapa de tu crecimiento global.
          </p>

          <!-- Key Features -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <div class="flex items-center gap-2">
              <Globe class="w-5 h-5 text-tn-yellow" />
              <span class="text-sm">20+ Países</span>
            </div>
            <div class="flex items-center gap-2">
              <Truck class="w-5 h-5 text-tn-yellow" />
              <span class="text-sm">100+ Clientes</span>
            </div>
            <div class="flex items-center gap-2">
              <Award class="w-5 h-5 text-tn-yellow" />
              <span class="text-sm">15+ Años</span>
            </div>
          </div>

          <!-- Social Media -->
          <div class="flex gap-4">
            <a 
              href="#" 
              class="w-10 h-10 bg-white/10 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group"
              aria-label="LinkedIn"
            >
              <Linkedin class="w-5 h-5 group-hover:text-tn-blue" />
            </a>
            <a 
              href="#" 
              class="w-10 h-10 bg-white/10 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group"
              aria-label="Facebook"
            >
              <Facebook class="w-5 h-5 group-hover:text-tn-blue" />
            </a>
            <a 
              href="#" 
              class="w-10 h-10 bg-white/10 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group"
              aria-label="Instagram"
            >
              <Instagram class="w-5 h-5 group-hover:text-tn-blue" />
            </a>
          </div>
        </div>

        <!-- Services -->
        <div class="animate-on-scroll">
          <h4 class="text-lg font-intro-bold text-tn-yellow mb-6">Nuestros Servicios</h4>
          <ul class="space-y-3">
            <li>
              <a href="#servicios" class="text-gray-300 hover:text-tn-yellow transition-colors duration-300 text-sm">
                Asesoría Logística Internacional
              </a>
            </li>
            <li>
              <a href="#servicios" class="text-gray-300 hover:text-tn-yellow transition-colors duration-300 text-sm">
                Servicios Logísticos Integrales
              </a>
            </li>
            <li>
              <a href="#servicios" class="text-gray-300 hover:text-tn-yellow transition-colors duration-300 text-sm">
                Trámite de Vistos Buenos
              </a>
            </li>
            <li>
              <a href="#servicios" class="text-gray-300 hover:text-tn-yellow transition-colors duration-300 text-sm">
                Planeación Logística Integral
              </a>
            </li>
            <li>
              <a href="#servicios" class="text-gray-300 hover:text-tn-yellow transition-colors duration-300 text-sm">
                Capacitaciones Personalizadas
              </a>
            </li>
            <li>
              <a href="#servicios" class="text-gray-300 hover:text-tn-yellow transition-colors duration-300 text-sm">
                Asistencia Comercial en China
              </a>
            </li>
          </ul>
        </div>

        <!-- Contact Info -->
        <div class="animate-on-scroll">
          <h4 class="text-lg font-intro-bold text-tn-yellow mb-6">Contacto</h4>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <Mail class="w-5 h-5 text-tn-yellow mt-1 flex-shrink-0" />
              <div>
                <div class="text-sm text-gray-400">Email</div>
                <a href="mailto:info@tnlogistics.com" class="text-white hover:text-tn-yellow transition-colors">
                  info@tnlogistics.com.co
                </a>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <Phone class="w-5 h-5 text-tn-yellow mt-1 flex-shrink-0" />
              <div>
                <div class="text-sm text-gray-400">Teléfono</div>
                <a href="tel:+5712345678" class="text-white hover:text-tn-yellow transition-colors">
                  +57 350 462 0171
                </a>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <MapPin class="w-5 h-5 text-tn-yellow mt-1 flex-shrink-0" />
              <div>
                <div class="text-sm text-gray-400">Ubicación</div>
                <div class="text-white">Bogotá, Colombia</div>
              </div>
            </div>
          </div>

          <!-- Business Hours -->
          <div class="mt-6 p-4 bg-white/5 rounded-xl">
            <h5 class="font-intro-bold text-tn-yellow mb-3 text-sm">Horarios de Atención</h5>
            <div class="space-y-1 text-xs text-gray-300">
              <div class="flex justify-between">
                <span>Lun - Vie:</span>
                <span>8:00 AM - 6:00 PM</span>
              </div>
              <div class="flex justify-between">
                <span>Sábado:</span>
                <span>9:00 AM - 12:00 PM</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/20 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="text-sm text-gray-400">
          © 2024 TN Logistics & Services S.A.S. Todos los derechos reservados.
        </div>
        
        <div class="flex items-center gap-6 text-sm">
          <a href="#" class="text-gray-400 hover:text-tn-yellow transition-colors">
            Política de Privacidad
          </a>
          <a href="#" class="text-gray-400 hover:text-tn-yellow transition-colors">
            Términos de Servicio
          </a>
          <a href="#" class="text-gray-400 hover:text-tn-yellow transition-colors">
            Cookies
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Back to Top Button -->
  <button 
    id="back-to-top"
    class="fixed bottom-8 right-8 w-12 h-12 bg-tn-yellow hover:bg-tn-yellow-light text-tn-blue rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 opacity-0 invisible z-50"
    aria-label="Volver arriba"
  >
    <ArrowUp class="w-6 h-6 mx-auto" />
  </button>
</footer>

<script>
  // Back to top functionality
  const backToTopButton = document.getElementById('back-to-top');
  
  if (backToTopButton) {
    window.addEventListener('scroll', () => {
      if (window.pageYOffset > 300) {
        backToTopButton.classList.remove('opacity-0', 'invisible');
        backToTopButton.classList.add('opacity-100', 'visible');
      } else {
        backToTopButton.classList.add('opacity-0', 'invisible');
        backToTopButton.classList.remove('opacity-100', 'visible');
      }
    });

    backToTopButton.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>
