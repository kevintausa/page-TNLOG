  // Show service modal function
  function showServiceModal(serviceKey) {
    const service = servicesData[serviceKey];
    if (!service) return;

    // Create modal HTML
    const modalHTML = `
      <div class="service-modal" id="serviceModal">
        <div class="service-modal-content">
          <div class="service-modal-header">
            <button class="service-modal-close" onclick="closeServiceModal()">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            <h2 class="text-3xl md:text-4xl font-intro-bold mb-4">${service.title}</h2>
            <p class="text-xl opacity-90">${service.description}</p>
          </div>
          
          <div class="service-modal-body">
            <!-- Benefits Section -->
            <div class="mb-8">
              <h3 class="text-2xl font-intro-bold text-tn-blue mb-6">Beneficios de nuestro servicio</h3>
              <div class="space-y-3">
                ${service.benefits.map(benefit => `
                  <div class="service-benefit-item">
                    <svg class="w-6 h-6 text-tn-yellow flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <p class="text-gray-700 leading-relaxed">${benefit}</p>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- Process Section -->
            <div class="mb-8">
              <h3 class="text-2xl font-intro-bold text-tn-blue mb-6">Nuestro proceso</h3>
              <div class="grid md:grid-cols-2 gap-6">
                ${service.process.map((step, index) => `
