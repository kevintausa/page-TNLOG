                    <div class="flex items-center mb-3">
                      <div class="w-8 h-8 bg-tn-yellow rounded-full flex items-center justify-center text-tn-blue font-intro-bold mr-3">
                        ${index + 1}
                      </div>
                      <h4 class="text-lg font-intro-bold text-tn-blue">${step.title}</h4>
                    </div>
                    <p class="text-gray-600 leading-relaxed">${step.description}</p>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- CTA Section -->
            <div class="text-center bg-gradient-to-r from-tn-blue to-tn-blue-dark rounded-2xl p-8 text-white">
              <h3 class="text-2xl font-intro-bold mb-4">¿Listo para optimizar tu logística?</h3>
              <p class="text-lg mb-6 opacity-90">Contáctanos hoy y descubre cómo podemos transformar tus operaciones</p>
              <a href="#contacto" onclick="closeServiceModal()" class="inline-block bg-tn-yellow hover:bg-tn-yellow-light text-tn-blue font-intro-bold px-8 py-4 rounded-full text-lg transition-all duration-300 transform hover:scale-105">
                Contactar ahora
              </a>
            </div>
          </div>
        </div>
      </div>
    `;

    // Add modal to body
    document.body.insertAdjacentHTML('beforeend', modalHTML);
    
    // Show modal with animation
    setTimeout(() => {
      const modal = document.getElementById('serviceModal');
      if (modal) {
        modal.classList.add('active');
      }
    }, 100);
  }

  // Close service modal function
  function closeServiceModal() {
    const modal = document.getElementById('serviceModal');
    if (modal) {
      modal.classList.remove('active');
      setTimeout(() => {
        modal.remove();
        // Clean up transition states
        document.body.classList.remove('transitioning');
        const overlays = document.querySelectorAll('.circle-reveal-overlay');
        overlays.forEach(overlay => overlay.remove());
        const cards = document.querySelectorAll('.service-card-expanding');
        cards.forEach(card => card.classList.remove('service-card-expanding'));
      }, 500);
    }
  }

  // Make functions globally available
  (window as any).showServiceModal = showServiceModal;
  (window as any).closeServiceModal = closeServiceModal;

  // Close modal on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeServiceModal();
    }
  });

  // Close modal on backdrop click
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.classList.contains('service-modal')) {
      closeServiceModal();
    }
  });
</script>
