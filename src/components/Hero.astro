---
import { 
  ArrowRight, 
  Globe, 
  Truck, 
  Target,
  Compass,
  FileCheck,
  Settings,
  GraduationCap,
  MapPin,
  ChevronLeft,
  ChevronRight
} from 'lucide-astro';
---

<section id="inicio" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-tn-blue via-tn-blue-dark to-tn-blue pt-20">
  <!-- Dynamic background images -->
  <div class="absolute inset-0 transition-all duration-1000 ease-in-out" id="bg-container">
    <!-- Background image layers for each service -->
    <!-- Asesoría y Consultoría Logística -->
    <div class="bg-image active absolute inset-0 bg-cover bg-center bg-no-repeat opacity-10" 
         style="background-image: url('/images/services/logistica-internacional.jpg')"
         data-service="0"></div>
    
    <!-- Servicios Logísticos Integrales -->
    <div class="bg-image absolute inset-0 bg-cover bg-center bg-no-repeat opacity-0" 
         style="background-image: url('/images/services/transporte-integral.jpg')"
         data-service="1"></div>
    
    <!-- Trámite de Vistos Buenos -->
    <div class="bg-image absolute inset-0 bg-cover bg-center bg-no-repeat opacity-0" 
         style="background-image: url('/images/services/documentos-permisos.jpg')"
         data-service="2"></div>
    
    <!-- Planeación Logística Integral -->
    <div class="bg-image absolute inset-0 bg-cover bg-center bg-no-repeat opacity-0" 
         style="background-image: url('/images/services/planeacion-logistica.jpg')"
         data-service="3"></div>
    
    <!-- Capacitaciones Personalizadas -->
    <div class="bg-image absolute inset-0 bg-cover bg-center bg-no-repeat opacity-0" 
         style="background-image: url('/images/services/capacitacion-empresarial.jpg')"
         data-service="4"></div>
    
    <!-- Asistencia Comercial en China -->
    <div class="bg-image absolute inset-0 bg-cover bg-center bg-no-repeat opacity-0" 
         style="background-image: url('/images/services/china-comercial.jpg')"
         data-service="5"></div>
    
    <!-- Overlay gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-tn-blue/40 via-tn-blue-dark/45 to-tn-blue/40"></div>
  </div>

  <!-- Animated pattern overlay -->
  <div class="absolute inset-0 opacity-10">
    <div class="parallax-bg absolute inset-0 pattern-dots"></div>
  </div>

  <!-- Floating elements -->
  <div class="absolute top-20 left-10 animate-bounce-in" style="animation-delay: 0.5s;">
    <Globe class="w-8 h-8 text-tn-yellow opacity-60" />
  </div>
  <div class="absolute top-40 right-20 animate-bounce-in" style="animation-delay: 1s;">
    <Truck class="w-10 h-10 text-tn-yellow opacity-60" />
  </div>
  <div class="absolute bottom-40 left-20 animate-bounce-in" style="animation-delay: 1.5s;">
    <Target class="w-6 h-6 text-tn-yellow opacity-60" />
  </div>

  <div class="container mx-auto px-6 text-center relative z-10">
    <!-- Dynamic headline with rotating services -->
    <div class="animate-slide-up max-w-5xl mx-auto" style="animation-delay: 0.3s;">
      <div class="mb-8">
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-intro-bold text-white mb-2 leading-tight tracking-tight">
          <span class="block">Expandiendo</span>
          <span class="text-tn-yellow drop-shadow-lg">Horizontes</span>
        </h2>
        
        <!-- Complete slogan integrated -->
        <p class="text-2xl md:text-3xl lg:text-5xl font-intro-bold text-white leading-tight opacity-95">
          Con soluciones logísticas integrales
        </p>
      </div>
      
      <!-- Dynamic rotating service text -->
      <div class="h-16 md:h-20 lg:h-24 flex items-center justify-center mb-3">
        <h3 class="text-xl md:text-2xl lg:text-3xl font-intro text-white opacity-95 text-center">
          <span class="block mb-2">Especialistas en</span>
          <span id="rotating-service" class="text-tn-yellow font-intro-bold drop-shadow-lg inline-block min-h-[1.2em]">
            Logística Internacional
          </span>
        </h3>
      </div>
      
      <!-- Service description that changes -->
      <div class="h-12 md:h-16 flex items-center justify-center">
        <p id="service-description" class="text-lg md:text-xl text-gray-200 leading-relaxed text-center max-w-3xl transition-all duration-500">
          Conectamos tu empresa con oportunidades globales a través de soluciones logísticas integrales
        </p>
      </div>
    </div>


    <!-- CTA Button -->
    <div class="animate-scale-in mt-5" style="animation-delay: 0.9s;">
      <a 
        href="#servicios" 
        class="inline-flex items-center gap-2 bg-tn-yellow hover:bg-tn-yellow-light text-tn-blue font-intro-bold px-8 py-4 rounded-full text-base md:text-lg transition-all duration-300 transform hover:scale-105 hover:shadow-2xl shadow-lg group relative overflow-hidden"
      >
        <span class="relative z-10">Conoce nuestros servicios</span>
        <ArrowRight class="w-5 h-5 transition-transform group-hover:translate-x-1 relative z-10" />
        
        <!-- Button glow effect -->
        <div class="absolute inset-0 bg-gradient-to-r from-tn-yellow-light to-tn-yellow opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </a>
    </div>

    <!-- Vertical Service Navigation -->
    <div class="service-navigation fixed right-6 top-1/2 transform -translate-y-1/2 z-20 hidden lg:block">
      <!-- Mini toggle button (shown when navigation is hidden) -->
      <button 
        id="show-navigation" 
        class="navigation-toggle absolute -left-12 top-1/2 transform -translate-y-1/2 w-10 h-10 bg-black/40 backdrop-blur-md rounded-full flex items-center justify-center transition-all duration-300 opacity-0 pointer-events-none hover:bg-tn-yellow group"
        aria-label="Mostrar navegación de servicios"
      >
        <div class="flex flex-col gap-1">
          <div class="w-1 h-1 bg-white group-hover:bg-tn-blue rounded-full"></div>
          <div class="w-1 h-1 bg-white group-hover:bg-tn-blue rounded-full"></div>
          <div class="w-1 h-1 bg-white group-hover:bg-tn-blue rounded-full"></div>
          <div class="w-1 h-1 bg-white group-hover:bg-tn-blue rounded-full"></div>
          <div class="w-1 h-1 bg-white group-hover:bg-tn-blue rounded-full"></div>
          <div class="w-1 h-1 bg-white group-hover:bg-tn-blue rounded-full"></div>
        </div>
      </button>
      <!-- Service Icons Navigation - Vertical -->
      <div class="flex flex-col items-center gap-3 bg-black/20 backdrop-blur-md rounded-2xl px-3 py-4 border border-white/10 shadow-lg">
        <!-- Previous Button -->
        <button 
          id="prev-service" 
          class="w-10 h-10 bg-white/20 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group"
          aria-label="Servicio anterior"
        >
          <ChevronLeft class="w-4 h-4 text-white group-hover:text-tn-blue rotate-90" />
        </button>

        <!-- Separator -->
        <div class="w-6 h-px bg-white/20"></div>

        <!-- Service Icons -->
        <div class="flex flex-col gap-3">
          <!-- Asesoría y Consultoría Logística -->
          <button 
            class="service-nav-btn active w-12 h-12 bg-tn-yellow rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group relative" 
            data-service="0"
            title="Asesoría y Consultoría Logística"
          >
            <Compass class="w-6 h-6 text-tn-blue" />
            <!-- Service indicator -->
            <div class="absolute -left-2 top-1/2 transform -translate-y-1/2 w-1 h-8 bg-tn-yellow rounded-full opacity-100"></div>
          </button>

          <!-- Servicios Logísticos Integrales -->
          <button 
            class="service-nav-btn w-12 h-12 bg-white/20 hover:bg-tn-yellow rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group relative" 
            data-service="1"
            title="Servicios Logísticos Integrales"
          >
            <Truck class="w-6 h-6 text-white group-hover:text-tn-blue" />
            <!-- Service indicator -->
            <div class="absolute -left-2 top-1/2 transform -translate-y-1/2 w-1 h-8 bg-tn-yellow rounded-full opacity-0 transition-opacity duration-300"></div>
          </button>

          <!-- Trámite de Vistos Buenos -->
          <button 
            class="service-nav-btn w-12 h-12 bg-white/20 hover:bg-tn-yellow rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group relative" 
            data-service="2"
            title="Trámite de Vistos Buenos"
          >
            <FileCheck class="w-6 h-6 text-white group-hover:text-tn-blue" />
            <!-- Service indicator -->
            <div class="absolute -left-2 top-1/2 transform -translate-y-1/2 w-1 h-8 bg-tn-yellow rounded-full opacity-0 transition-opacity duration-300"></div>
          </button>

          <!-- Planeación Logística Integral -->
          <button 
            class="service-nav-btn w-12 h-12 bg-white/20 hover:bg-tn-yellow rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group relative" 
            data-service="3"
            title="Planeación Logística Integral"
          >
            <Settings class="w-6 h-6 text-white group-hover:text-tn-blue" />
            <!-- Service indicator -->
            <div class="absolute -left-2 top-1/2 transform -translate-y-1/2 w-1 h-8 bg-tn-yellow rounded-full opacity-0 transition-opacity duration-300"></div>
          </button>

          <!-- Capacitaciones Personalizadas -->
          <button 
            class="service-nav-btn w-12 h-12 bg-white/20 hover:bg-tn-yellow rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group relative" 
            data-service="4"
            title="Capacitaciones Personalizadas"
          >
            <GraduationCap class="w-6 h-6 text-white group-hover:text-tn-blue" />
            <!-- Service indicator -->
            <div class="absolute -left-2 top-1/2 transform -translate-y-1/2 w-1 h-8 bg-tn-yellow rounded-full opacity-0 transition-opacity duration-300"></div>
          </button>

          <!-- Asistencia Comercial en China -->
          <button 
            class="service-nav-btn w-12 h-12 bg-white/20 hover:bg-tn-yellow rounded-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group relative" 
            data-service="5"
            title="Asistencia Comercial en China"
          >
            <MapPin class="w-6 h-6 text-white group-hover:text-tn-blue" />
            <!-- Service indicator -->
            <div class="absolute -left-2 top-1/2 transform -translate-y-1/2 w-1 h-8 bg-tn-yellow rounded-full opacity-0 transition-opacity duration-300"></div>
          </button>
        </div>

        <!-- Separator -->
        <div class="w-6 h-px bg-white/20"></div>

        <!-- Next Button -->
        <button 
          id="next-service" 
          class="w-10 h-10 bg-white/20 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group"
          aria-label="Siguiente servicio"
        >
          <ChevronRight class="w-4 h-4 text-white group-hover:text-tn-blue rotate-90" />
        </button>
      </div>
    </div>

    <!-- Mobile Service Navigation (Bottom) -->
    <div class="service-navigation-mobile absolute bottom-16 left-1/2 transform -translate-x-1/2 z-20 lg:hidden">
      <!-- Service Icons Navigation - Horizontal for Mobile -->
      <div class="flex items-center gap-2 bg-black/30 backdrop-blur-md rounded-full px-4 py-3 border border-white/10 shadow-lg">
        <!-- Service Icons Only (No prev/next on mobile) -->
        <div class="flex gap-2">
          <!-- Asesoría y Consultoría Logística -->
          <button 
            class="service-nav-btn active w-10 h-10 bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group" 
            data-service="0"
            title="Asesoría y Consultoría Logística"
          >
            <Compass class="w-5 h-5 text-tn-blue" />
          </button>

          <!-- Servicios Logísticos Integrales -->
          <button 
            class="service-nav-btn w-10 h-10 bg-white/20 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group" 
            data-service="1"
            title="Servicios Logísticos Integrales"
          >
            <Truck class="w-5 h-5 text-white group-hover:text-tn-blue" />
          </button>

          <!-- Trámite de Vistos Buenos -->
          <button 
            class="service-nav-btn w-10 h-10 bg-white/20 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group" 
            data-service="2"
            title="Trámite de Vistos Buenos"
          >
            <FileCheck class="w-5 h-5 text-white group-hover:text-tn-blue" />
          </button>

          <!-- Planeación Logística Integral -->
          <button 
            class="service-nav-btn w-10 h-10 bg-white/20 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group" 
            data-service="3"
            title="Planeación Logística Integral"
          >
            <Settings class="w-5 h-5 text-white group-hover:text-tn-blue" />
          </button>

          <!-- Capacitaciones Personalizadas -->
          <button 
            class="service-nav-btn w-10 h-10 bg-white/20 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group" 
            data-service="4"
            title="Capacitaciones Personalizadas"
          >
            <GraduationCap class="w-5 h-5 text-white group-hover:text-tn-blue" />
          </button>

          <!-- Asistencia Comercial en China -->
          <button 
            class="service-nav-btn w-10 h-10 bg-white/20 hover:bg-tn-yellow rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110 group" 
            data-service="5"
            title="Asistencia Comercial en China"
          >
            <MapPin class="w-5 h-5 text-white group-hover:text-tn-blue" />
          </button>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
  <!--   <div class="absolute bottom-8 animate-bounce">
      <div class="w-6 h-10 border-2 border-tn-yellow rounded-full flex justify-center">
        <div class="w-1 h-3 bg-tn-yellow rounded-full mt-2 animate-pulse"></div>
      </div>
    </div> -->
  </div>

  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-tn-blue-dark/20 to-transparent pointer-events-none"></div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }
  
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  /* Logo glow effect */
  .logo-container {
    position: relative;
  }
  
  .logo-container::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(45deg, #FACB00, #2A3B70, #FACB00);
    border-radius: 1.5rem;
    opacity: 0;
    z-index: -1;
    transition: opacity 0.3s ease;
  }
  
  .logo-container:hover::before {
    opacity: 0.1;
  }

  /* Enhanced shadow */
  .shadow-3xl {
    box-shadow: 0 35px 60px -12px rgba(0, 0, 0, 0.25);
  }

  /* Background image transitions */
  .bg-image {
    transition: opacity 1.2s ease-in-out, transform 1.2s ease-in-out;
    transform: scale(1.05);
  }

  .bg-image.active {
    opacity: 0.7 !important;
    transform: scale(1);
  }

  /* Patrón de puntos */
  .pattern-dots {
    background-image: radial-gradient(circle at 2px 2px, #FACB00 1px, transparent 0);
    background-size: 30px 30px;
    animation: patternMove 15s linear infinite;
  }

  @keyframes patternMove {
    0% { background-position: 0 0; }
    100% { background-position: 30px 30px; }
  }

  .bg-image.fade-out {
    opacity: 0 !important;
    transform: scale(1.1);
  }

  /* Parallax effect for backgrounds */
  @keyframes backgroundFloat {
    0%, 100% { transform: scale(1) translateY(0px); }
    50% { transform: scale(1.02) translateY(-10px); }
  }

  .bg-image.active {
    animation: backgroundFloat 20s ease-in-out infinite;
  }

  /* Text rotation animations */
  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes slideOutUp {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateY(-30px) scale(0.95);
    }
  }

  .slide-in {
    animation: slideInUp 0.6s ease-out forwards;
  }

  .slide-out {
    animation: slideOutUp 0.4s ease-in forwards;
  }

  /* Typing effect */
  @keyframes typing {
    from { width: 0; }
    to { width: 100%; }
  }

  @keyframes blink {
    0%, 50% { border-color: transparent; }
    51%, 100% { border-color: #FACB00; }
  }

  .typing-effect {
    overflow: hidden;
    border-right: 3px solid #FACB00;
    white-space: nowrap;
    animation: typing 2s steps(20) forwards, blink 1s infinite;
  }

  /* Service Navigation Styles */
  .service-nav-btn {
    position: relative;
    overflow: hidden;
  }

  .service-nav-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(250, 203, 0, 0.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: all 0.3s ease;
  }

  .service-nav-btn:hover::before {
    width: 100%;
    height: 100%;
  }

  .service-nav-btn.active::before {
    width: 120%;
    height: 120%;
    background: rgba(250, 203, 0, 0.2);
  }

  /* Service title transitions */
  #current-service-title {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Vertical Navigation Styles */
  .service-navigation {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .service-navigation:hover {
    transform: translateY(-50%) scale(1.02);
  }

  .service-navigation.hidden {
    opacity: 0;
    transform: translateY(-50%) translateX(100px);
    pointer-events: none;
  }

  .service-navigation.hidden .navigation-toggle {
    opacity: 1;
    pointer-events: all;
    transform: translateY(-50%) translateX(-20px);
  }

  .navigation-toggle {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Service indicator animations */
  .service-nav-btn .absolute {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .service-nav-btn.active .absolute {
    opacity: 1 !important;
    transform: translateY(-50%) scale(1.2);
  }

  /* Mobile Navigation Styles */
  .service-navigation-mobile {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .service-navigation-mobile.hidden {
    opacity: 0;
    transform: translate(-50%, 20px);
    pointer-events: none;
  }

  /* Responsive adjustments */
  @media (max-width: 1024px) {
    .service-navigation {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .service-navigation-mobile .service-nav-btn {
      width: 2.5rem;
      height: 2.5rem;
    }
    
    .service-navigation-mobile .service-nav-btn svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .service-navigation-mobile .service-nav-btn {
      width: 2rem;
      height: 2rem;
    }
    
    .service-navigation-mobile .service-nav-btn svg {
      width: 1rem;
      height: 1rem;
    }

    .service-navigation-mobile > div {
      padding: 0.5rem 0.75rem;
      gap: 0.375rem;
    }

    .service-navigation-mobile .flex {
      gap: 0.375rem;
    }
  }

  /* Vertical navigation positioning adjustments */
  @media (max-height: 800px) {
    .service-navigation {
      right: 1rem;
    }
  }

  @media (max-height: 700px) {
    .service-navigation-mobile {
      bottom: 0.75rem;
    }
  }

  /* Hover effects for vertical navigation */
  .service-navigation .service-nav-btn:hover .absolute {
    opacity: 0.6 !important;
    transform: translateY(-50%) scale(1.1);
  }

  /* Smooth scroll behavior */
  .service-navigation,
  .service-navigation-mobile {
    scroll-behavior: smooth;
  }
</style>

<script>
  // Dynamic service rotation
  const services = [
    {
      title: "Asesoría y Consultoría Logística",
      description: "Diseñamos soluciones logísticas a la medida, desde la planeación hasta la entrega final con optimización de tiempos y reducción de riesgos"
    },
    {
      title: "Servicios Logísticos Integrales",
      description: "Coordinamos la gestión operativa y documental para garantizar un flujo logístico eficiente y seguro en transporte internacional"
    },
    {
      title: "Trámite de Vistos Buenos",
      description: "Gestionamos permisos, licencias y vistos buenos ante autoridades competentes, asegurando el cumplimiento normativo de cada operación"
    },
    {
      title: "Planeación Logística Integral",
      description: "Acompañamiento completo desde la compra internacional hasta la nacionalización, logrando eficiencia y trazabilidad total"
    },
    {
      title: "Capacitaciones Personalizadas",
      description: "Programas de formación en comercio exterior y logística internacional para emprendedores y PYMES con enfoque práctico"
    },
    {
      title: "Asistencia Comercial en China",
      description: "Acompañamiento profesional en búsqueda, validación y negociación con proveedores asiáticos, incluyendo control de calidad"
    }
  ];

  let currentServiceIndex = 0;
  let autoRotationInterval;
  const rotatingServiceElement = document.getElementById('rotating-service');
  const serviceDescriptionElement = document.getElementById('service-description');
  const serviceTitleElement = document.getElementById('current-service-title');
  const backgroundImages = document.querySelectorAll('.bg-image');
  const serviceNavButtons = document.querySelectorAll('.service-nav-btn');
  const prevButton = document.getElementById('prev-service');
  const nextButton = document.getElementById('next-service');

  function updateBackgroundImage(serviceIndex) {
    // Remove active class from all backgrounds
    backgroundImages.forEach((bg, index) => {
      bg.classList.remove('active', 'fade-out');
      if (index === serviceIndex) {
        // Add active class to current service background
        setTimeout(() => {
          bg.classList.add('active');
        }, 100);
      } else {
        // Add fade-out class to others
        bg.classList.add('fade-out');
      }
    });
  }

  function updateNavigationButtons(serviceIndex) {
    // Update navigation buttons (both desktop and mobile)
    serviceNavButtons.forEach((btn, index) => {
      btn.classList.remove('active', 'bg-tn-yellow');
      btn.classList.add('bg-white/20');
      const icon = btn.querySelector('svg');
      const indicator = btn.querySelector('.absolute');
      
      if (icon) {
        icon.classList.remove('text-tn-blue');
        icon.classList.add('text-white');
      }
      
      // Hide indicator
      if (indicator) {
        indicator.style.opacity = '0';
      }
      
      if (index === serviceIndex) {
        btn.classList.add('active', 'bg-tn-yellow');
        btn.classList.remove('bg-white/20');
        if (icon) {
          icon.classList.add('text-tn-blue');
          icon.classList.remove('text-white');
        }
        // Show indicator
        if (indicator) {
          indicator.style.opacity = '1';
        }
      }
    });
  }

  function updateService(newIndex = null) {
    if (!rotatingServiceElement || !serviceDescriptionElement) return;

    // If newIndex is provided, use it; otherwise use current rotation logic
    if (newIndex !== null) {
      currentServiceIndex = newIndex;
    }

    const currentService = services[currentServiceIndex];
    
    // Update background image
    updateBackgroundImage(currentServiceIndex);
    
    // Update navigation buttons
    updateNavigationButtons(currentServiceIndex);
    
    // Add exit animation
    rotatingServiceElement.classList.add('slide-out');
    serviceDescriptionElement.style.opacity = '0';
    serviceDescriptionElement.style.transform = 'translateY(20px)';
    
    // Update service title in navigation
    if (serviceTitleElement) {
      serviceTitleElement.style.opacity = '0';
      serviceTitleElement.style.transform = 'translateY(10px)';
    }
    
    setTimeout(() => {
      // Update content
      rotatingServiceElement.textContent = currentService.title;
      serviceDescriptionElement.textContent = currentService.description;
      
      if (serviceTitleElement) {
        serviceTitleElement.textContent = currentService.title;
      }
      
      // Remove exit animation and add enter animation
      rotatingServiceElement.classList.remove('slide-out');
      rotatingServiceElement.classList.add('slide-in');
      
      // Animate description
      serviceDescriptionElement.style.opacity = '1';
      serviceDescriptionElement.style.transform = 'translateY(0)';
      
      // Animate service title
      if (serviceTitleElement) {
        serviceTitleElement.style.opacity = '1';
        serviceTitleElement.style.transform = 'translateY(0)';
      }
      
      setTimeout(() => {
        rotatingServiceElement.classList.remove('slide-in');
      }, 600);
      
    }, 400);

    // Only auto-increment if not manually triggered
    if (newIndex === null) {
      currentServiceIndex = (currentServiceIndex + 1) % services.length;
    }
  }

  function goToService(index) {
    // Stop auto rotation temporarily
    if (autoRotationInterval) {
      clearInterval(autoRotationInterval);
    }
    
    updateService(index);
    
    // Restart auto rotation after 8 seconds
    setTimeout(() => {
      startAutoRotation();
    }, 8000);
  }

  function nextService() {
    const nextIndex = (currentServiceIndex + 1) % services.length;
    goToService(nextIndex);
  }

  function prevService() {
    const prevIndex = (currentServiceIndex - 1 + services.length) % services.length;
    goToService(prevIndex);
  }

  function startAutoRotation() {
    if (autoRotationInterval) {
      clearInterval(autoRotationInterval);
    }
    autoRotationInterval = setInterval(() => {
      currentServiceIndex = (currentServiceIndex + 1) % services.length;
      updateService();
    }, 4000);
  }

  // Initialize navigation
  document.addEventListener('DOMContentLoaded', () => {
    const navigationContainer = document.querySelector('.service-navigation');
    const mobileNavigationContainer = document.querySelector('.service-navigation-mobile');
    const showNavigationButton = document.getElementById('show-navigation');
    let lastScrollY = window.scrollY;
    let isNavigationVisible = true;
    let isNavigationTemporarilyShown = false;

    // Ensure navigation is visible by default
    if (navigationContainer) {
      navigationContainer.classList.remove('hidden');
    }
    if (mobileNavigationContainer) {
      mobileNavigationContainer.classList.remove('hidden');
    }

    // Add event listeners to navigation buttons (both desktop and mobile)
    serviceNavButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        goToService(index);
      });
    });

    // Add event listeners to prev/next buttons (desktop only)
    if (prevButton) {
      prevButton.addEventListener('click', prevService);
    }
    
    if (nextButton) {
      nextButton.addEventListener('click', nextService);
    }

    // Add event listener to show navigation button
    if (showNavigationButton) {
      showNavigationButton.addEventListener('click', () => {
        if (navigationContainer) {
          navigationContainer.classList.remove('hidden');
          isNavigationTemporarilyShown = true;
          
          // Auto-hide after 5 seconds of inactivity
          setTimeout(() => {
            const heroSection = document.getElementById('inicio');
            const currentScrollY = window.scrollY;
            
            if (heroSection && currentScrollY > heroSection.offsetTop + heroSection.offsetHeight - 150) {
              navigationContainer.classList.add('hidden');
              isNavigationTemporarilyShown = false;
            }
          }, 5000);
        }
      });
    }

    // Add keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        prevService();
      } else if (e.key === 'ArrowRight') {
        nextService();
      }
    });

    // Auto-hide both navigations on scroll
    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      const heroSection = document.getElementById('inicio');
      
      if (heroSection) {
        const heroBottom = heroSection.offsetTop + heroSection.offsetHeight;
        
        // Hide both navigations when scrolling past hero section
        if (currentScrollY > heroBottom - 150) {
          if (isNavigationVisible && !isNavigationTemporarilyShown) {
            // Hide desktop navigation
            if (navigationContainer) {
              navigationContainer.classList.add('hidden');
            }
            // Hide mobile navigation
            if (mobileNavigationContainer) {
              mobileNavigationContainer.classList.add('hidden');
            }
            isNavigationVisible = false;
          }
        } else {
          if (!isNavigationVisible || currentScrollY === 0) {
            // Show desktop navigation
            if (navigationContainer) {
              navigationContainer.classList.remove('hidden');
            }
            // Show mobile navigation
            if (mobileNavigationContainer) {
              mobileNavigationContainer.classList.remove('hidden');
            }
            isNavigationVisible = true;
            isNavigationTemporarilyShown = false;
          }
        }
      }
      
      lastScrollY = currentScrollY;
    });

    // Initialize first service display
    updateNavigationButtons(0);
    
    // Add typing effect to initial service
    if (rotatingServiceElement) {
      rotatingServiceElement.classList.add('typing-effect');
      setTimeout(() => {
        rotatingServiceElement.classList.remove('typing-effect');
        rotatingServiceElement.style.borderRight = 'none';
      }, 2500);
    }

    // Start auto rotation after initial load
    setTimeout(() => {
      startAutoRotation();
    }, 3000);
  });
</script>
