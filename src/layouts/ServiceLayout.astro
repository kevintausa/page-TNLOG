---
import Layout from './Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { ArrowLeft, CheckCircle } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  icon: string;
  heroImage: string;
  benefits: string[];
  process: { title: string; description: string }[];
}

const { title, description, icon, heroImage, benefits, process } = Astro.props;
---

<Layout title={`${title} - TN Logistics & Services S.A.S.`}>
  <Navigation />
  
  <!-- Hero Section with expanding animation -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20" id="service-hero">
    <!-- Background Image -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-all duration-1000 ease-out" 
         style={`background-image: url('${heroImage}')`}
         id="hero-bg">
      <div class="absolute inset-0 bg-gradient-to-br from-tn-blue/70 via-tn-blue-dark/75 to-tn-blue/70"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-6 text-center relative z-10">
      <!-- Back Button -->
      <div class="absolute top-8 left-6 animate-fade-in">
        <a 
          href="/#servicios" 
          class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md text-white hover:bg-white/20 px-4 py-2 rounded-full transition-all duration-300 group"
        >
          <ArrowLeft class="w-4 h-4 transition-transform group-hover:-translate-x-1" />
          Volver a servicios
        </a>
      </div>

      <!-- Service Icon -->
      <div class="animate-scale-in mb-8" style="animation-delay: 0.2s;">
        <div class="w-24 h-24 bg-tn-yellow rounded-3xl flex items-center justify-center mx-auto shadow-2xl">
          <Fragment set:html={icon} />
        </div>
      </div>

      <!-- Title -->
      <div class="animate-slide-up" style="animation-delay: 0.4s;">
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-intro-bold text-white mb-6 leading-tight">
          {title}
        </h1>
      </div>

      <!-- Description -->
      <div class="animate-slide-up max-w-3xl mx-auto" style="animation-delay: 0.6s;">
        <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
          {description}
        </p>
      </div>

      <!-- CTA Button -->
      <div class="animate-scale-in mt-12" style="animation-delay: 0.8s;">
        <a 
          href="#contacto" 
          class="inline-flex items-center gap-3 bg-tn-yellow hover:bg-tn-yellow-light text-tn-blue font-intro-bold px-8 py-4 rounded-full text-lg transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
        >
          Solicitar cotización
        </a>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-intro-bold text-tn-blue text-center mb-16">
          Beneficios de nuestro servicio
        </h2>
        
        <div class="grid md:grid-cols-2 gap-8">
          {benefits.map((benefit, index) => (
            <div class="flex items-start gap-4 animate-on-scroll" style={`animation-delay: ${index * 0.1}s`}>
              <CheckCircle class="w-6 h-6 text-tn-yellow flex-shrink-0 mt-1" />
              <p class="text-gray-700 text-lg leading-relaxed">{benefit}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-intro-bold text-tn-blue text-center mb-16">
          Nuestro proceso
        </h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {process.map((step, index) => (
            <div class="bg-white rounded-2xl p-8 shadow-lg animate-on-scroll" style={`animation-delay: ${index * 0.2}s`}>
              <div class="w-12 h-12 bg-tn-yellow rounded-xl flex items-center justify-center mb-6">
                <span class="text-tn-blue font-intro-bold text-xl">{index + 1}</span>
              </div>
              <h3 class="text-xl font-intro-bold text-tn-blue mb-4">{step.title}</h3>
              <p class="text-gray-600 leading-relaxed">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-20 bg-gradient-to-r from-tn-blue to-tn-blue-dark">
    <div class="container mx-auto px-6 text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-intro-bold text-white mb-6">
          ¿Listo para optimizar tu logística?
        </h2>
        <p class="text-xl text-gray-200 mb-8 leading-relaxed">
          Contáctanos hoy y descubre cómo podemos transformar tus operaciones internacionales
        </p>
        <a 
          href="#contacto" 
          class="inline-flex items-center gap-3 bg-tn-yellow hover:bg-tn-yellow-light text-tn-blue font-intro-bold px-10 py-5 rounded-full text-lg transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl"
        >
          Contactar ahora
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Expanding animation for hero background */
  #hero-bg {
    transform: scale(1.1);
    animation: expandIn 1s ease-out forwards;
  }

  @keyframes expandIn {
    from {
      transform: scale(1.1);
      opacity: 0.8;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* Service page animations */
  .animate-scale-in {
    opacity: 0;
    transform: scale(0.8);
    animation: scaleIn 0.6s ease-out forwards;
  }

  .animate-slide-up {
    opacity: 0;
    transform: translateY(30px);
    animation: slideUp 0.6s ease-out forwards;
  }

  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 0.6s ease-out forwards;
  }

  @keyframes scaleIn {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes slideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  /* Scroll animations */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s ease-out;
  }

  .animate-on-scroll.in-view {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Scroll animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('in-view');
      }
    });
  }, observerOptions);

  document.querySelectorAll('.animate-on-scroll').forEach(el => {
    observer.observe(el);
  });

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });
</script>
